# Florin Terminal — example environment file.
# Copy to `.env` and fill in the values you need. Every key is optional; anything
# left blank falls back to the default shown. Most settings can also be configured
# at runtime via the dashboard Settings page (http://localhost:8000/settings).

# --- General ---
APP_ENV=development                       # development | production
LOG_LEVEL=INFO                            # DEBUG | INFO | WARNING | ERROR | CRITICAL
# DATABASE_URL=sqlite+aiosqlite:///./florin.db

# --- Market data: Alpaca (real-time quotes & streaming) ---
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_FEED=iex                           # iex (free) | sip (paid)

# --- Broker: Trading 212 (leave key blank to use the simulated paper broker) ---
T212_API_KEY=
T212_API_SECRET=
T212_ENVIRONMENT=demo                     # demo | live | readonly

# --- OpenFIGI (CUSIP -> ticker resolution for 13F filings; optional) ---
OPENFIGI_API_KEY=

# --- Sentiment: Reddit ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=florin-terminal/0.2 by u/yourname

# --- Sentiment / macro data: Alpha Vantage and Finnhub (optional) ---
ALPHAVANTAGE_API_KEY=
FINNHUB_API_KEY=

# --- LLM provider: Groq ---
GROQ_API_KEY=
GROQ_MODEL=llama-4-scout-17b-16e-instruct

# --- LLM provider: Google Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# --- LLM provider: Anthropic (Claude) ---
# Optional — if blank, local claude-agent-sdk CLI session auth is used when available.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514
CLAUDE_CLI_THINKING_MODE=low              # off | low | medium | high | max

# --- LLM provider: OpenRouter ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# --- Analysis mode ---
LLM_MODE=single                           # single | consensus
LLM_DEFAULT_PROVIDER=groq                 # groq | gemini | claude-cli | openrouter
LLM_CONSENSUS_META_PROVIDER=claude-cli    # groq | gemini | claude-cli | openrouter
LLM_USER_CONTEXT=

# --- Trading ---
PAPER_TRADING=true                        # must be explicitly false for live trading
DEFAULT_POSITION_SIZE=100.0
POSITION_SIZE_UNIT=gbp                    # gbp | usd | shares
DEFAULT_STOP_LOSS_PCT=10.0
MAX_OPEN_POSITIONS=10
MAX_DAILY_TRADES=20

# --- Screener ---
SCAN_PRICE_MIN=0.01
SCAN_PRICE_MAX=5.0
SCAN_MARKET_CAP_MIN=0.0
SCAN_MARKET_CAP_MAX=0.0
SCAN_MOMENTUM_THRESHOLD=5.0
SCAN_INTERVAL_SECONDS=120
SCAN_COOLDOWN_MINUTES=30
SCAN_MIN_VOLUME=10000

# --- Telegram bot (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Dashboard ---
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000
