# =============================================================================
# Penny Stock Sentinel — Environment Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# --- General ---
APP_ENV=development  # development | production
LOG_LEVEL=INFO
DATABASE_URL=sqlite+aiosqlite:///./sentinel.db

# --- Trading 212 ---
T212_API_KEY=
T212_API_SECRET=
T212_ENVIRONMENT=demo  # demo | live | readonly
# demo = https://demo.trading212.com/api/v0
# live = https://live.trading212.com/api/v0

# --- Market Data: Alpaca (Free Tier) ---
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_FEED=iex  # iex (free) | sip (paid)

# --- Market Data: Polygon.io (Paid Fallback) ---
POLYGON_API_KEY=

# --- Market Data: Financial Modeling Prep (Universe Discovery) ---
FMP_API_KEY=

# --- Sentiment: Reddit ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=penny-stock-sentinel/0.1 by u/YOUR_USERNAME

# --- LLM: Ollama (Local) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:8b

# --- LLM: Groq ---
GROQ_API_KEY=
GROQ_MODEL=llama-4-scout-17b-16e-instruct

# --- LLM: Google Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# --- LLM: Anthropic Claude ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=  # Your personal chat ID (whitelist)

# --- Scanner Settings ---
SCAN_PRICE_THRESHOLD=5.0       # Max price to qualify as penny stock ($)
SCAN_MOMENTUM_THRESHOLD=5.0    # Min % move to trigger alert
SCAN_INTERVAL_SECONDS=120      # How often to scan (seconds)
SCAN_COOLDOWN_MINUTES=30       # Don't re-alert same ticker within this window
SCAN_MIN_VOLUME=10000          # Minimum daily volume to consider

# --- Trading Settings ---
DEFAULT_POSITION_SIZE=100.0    # Default position size in account currency (£)
DEFAULT_STOP_LOSS_PCT=10.0     # Default stop-loss percentage
MAX_OPEN_POSITIONS=10          # Maximum concurrent positions
MAX_DAILY_TRADES=20            # Maximum trades per day

# --- LLM Analysis Mode ---
LLM_MODE=single                # single | consensus
LLM_DEFAULT_PROVIDER=groq      # ollama | groq | gemini | claude
LLM_CONSENSUS_META_PROVIDER=claude  # Which LLM analyses all reports in consensus mode

# --- Dashboard ---
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000
